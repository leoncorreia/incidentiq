# OpenAI-compatible chat completions URL (set to your Pipeshift endpoint in production).
PIPESHIFT_API_KEY=
PIPESHIFT_API_URL=https://api.openai.com/v1/chat/completions
PIPESHIFT_MODEL=gpt-4o-mini
HYDRADB_API_KEY=
# HydraDB Cloud tenant (SDK tenant_id). Falls back to HYDRADB_TENANT if unset.
HYDRADB_TENANT_ID=
HYDRADB_BASE_URL=https://api.hydradb.com
HYDRADB_TENANT=incidentiq-demo
# Optional: override SQLite path for HydraDB operational memory (default: data/hydradb.sqlite)
HYDRADB_STORE_PATH=
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://your-frontend.vercel.app
